  "paths": {
    "/api/v1/readiness/score": {
      "post": {
        "operationId": "assess_ai_readiness",
        "summary": "assess ai readiness",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://kit.tenhaw.com/schemas/readiness-response.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated deterministic result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result"
                  ],
                  "properties": {
                    "result": {
                      "$ref": "https://kit.tenhaw.com/schemas/readiness-report.schema.json"
                    },
                    "generator": {
                      "type": "object",
                      "required": [
                        "generator",
                        "version",
                        "url"
                      ],
                      "properties": {
                        "generator": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "413": {
            "description": "Request too large"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
