{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.tenhaw.com/schemas/okr.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "teamId": {
      "type": "string",
      "minLength": 1
    },
    "keyResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "number"
          },
          "target": {
            "type": "number"
          },
          "current": {
            "type": "number"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "description",
          "baseline",
          "target",
          "current",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "objective",
    "keyResults"
  ],
  "additionalProperties": false
}
