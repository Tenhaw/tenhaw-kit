{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.tenhaw.com/schemas/delivery-events.schema.json",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "commit"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "timestamp",
          "service"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "deployment"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "commitIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ]
          },
          "rework": {
            "type": "boolean"
          },
          "proxy": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type",
          "timestamp",
          "service",
          "environment",
          "commitIds",
          "status"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "incident"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "restoredAt": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "deploymentId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "startedAt",
          "service",
          "deploymentId"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "work-item"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "activeMinutes": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "type",
          "startedAt",
          "service"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "pull-request"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "firstReviewAt": {
            "type": "string",
            "format": "date-time"
          },
          "mergedAt": {
            "type": "string",
            "format": "date-time"
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "additions": {
            "type": "integer",
            "minimum": 0
          },
          "deletions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "type",
          "createdAt",
          "service"
        ],
        "additionalProperties": false
      }
    ]
  },
  "maxItems": 50000
}
