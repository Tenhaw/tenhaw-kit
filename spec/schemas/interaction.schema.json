{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.tenhaw.com/schemas/interaction.schema.json",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "collaboration",
        "X-as-a-Service",
        "facilitating"
      ]
    }
  },
  "required": [
    "from",
    "to",
    "mode"
  ],
  "additionalProperties": false
}
