{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.tenhaw.com/schemas/project-cost-input.schema.json",
  "type": "object",
  "properties": {
    "stage": {
      "enum": [
        "poc",
        "pilot",
        "production"
      ]
    },
    "people": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "durationWeeks": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "dayRate": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "stage"
  ],
  "additionalProperties": false
}
