{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kit.tenhaw.com/schemas/readiness-report.schema.json",
  "type": "object",
  "properties": {
    "frameworkVersion": {
      "const": "v1"
    },
    "overall": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "band": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Exploring",
        "Experimenting",
        "Scaling",
        "Embedded",
        "Leading",
        null
      ]
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "answered": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "const": 5
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "label",
          "weight",
          "score",
          "answered",
          "total",
          "coverage"
        ],
        "additionalProperties": false
      },
      "minItems": 6,
      "maxItems": 6
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "dimensionId": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "priority": {
            "type": "number",
            "minimum": 0
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "questionId",
          "dimensionId",
          "score",
          "priority",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "questionId",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contentCredit": {
      "const": "Tenhaw AI Readiness Framework, CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/), https://tenhaw.com."
    }
  },
  "required": [
    "frameworkVersion",
    "overall",
    "band",
    "coverage",
    "dimensions",
    "gaps",
    "recommendations",
    "limitations",
    "contentCredit"
  ],
  "additionalProperties": false
}
